{
  "name": "gog-achievements-cli",
  "version": "0.1.0",
  "description": "Mac GOG achievement restoration with JSON commands and saved queues",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22" },
  "bin": { "gog-achievements": "bin/gog-achievements.mjs" },
  "exports": "./src/index.mjs",
  "files": ["bin", "src", "native/bin/gog-login", "native/gog-login.swift", "scripts/build-native.mjs", "README.md", "LICENSE"],
  "dependencies": { "@napi-rs/keyring": "2.1.1" },
  "scripts": {
    "start": "node bin/gog-achievements.mjs",
    "test": "node --test --test-timeout=15000 test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "demo": "node scripts/demo.mjs",
    "build:mac": "node scripts/build-native.mjs"
  },
  "license": "MIT"
}
